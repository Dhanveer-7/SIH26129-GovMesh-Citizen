# GovMesh Citizen Portal Environment Configuration Example
# Copy this file to '.env' and configure for production backend integration.

# The base URL of the GovMesh Core Interoperability Backend
# In production, the Citizen Portal interacts ONLY with GovMesh Core.
# All department communication (Revenue, Food, Rural) is handled server-to-server.
VITE_API_BASE_URL=http://localhost:5000
VITE_GOVMESH_CORE_URL=http://localhost:5000

# Environment mode ('development', 'production', 'test')
VITE_APP_ENV=production
