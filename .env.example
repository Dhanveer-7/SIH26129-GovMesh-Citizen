# GovMesh Citizen Portal Environment Configuration Example
# Copy this file to '.env' and fill in values for production backend integration.

# The base URL of the GovMesh Core backend server / interoperability gateway
VITE_GOVMESH_API_BASE_URL=

# The base URL of the independently deployed Rural Development department portal API
VITE_RURAL_API_BASE_URL=

# Legacy environment fallback config (deprecated)
VITE_API_BASE_URL=

# Environment mode ('development', 'production', 'test')
VITE_APP_ENV=development
